# Copy to .env.local for `npm run dev` / `npm run worker` against a local Postgres.
APP_ENV=development
DATABASE_URL=postgres://makam:makam@127.0.0.1:5432/makam

# Sentry: leave empty to disable.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# Browser events take their environment from the page host (dev.makam.co.id = staging).
NEXT_PUBLIC_SENTRY_DSN=

# Optional, development and test only: Svix secret (whsec_...) the fake PaymentProvider signs webhooks with.
FAKE_PAYMENT_WEBHOOK_SECRET=

# Login sessions (Better Auth). Required in staging and production; development and test fall back to local values.
# AUTH_SECRET: at least 32 random characters, e.g. `openssl rand -base64 48`.
AUTH_SECRET=
# The site's own origin; https makes the session cookie Secure.
APP_BASE_URL=
# TOTP_ENCRYPTION_KEY: encrypts Admin Platform TOTP secrets at rest (AES-256-GCM). Exactly 32 bytes, standard base64:
# generate with `openssl rand -base64 32`. Required in staging and production; development and test fall back to a
# local key. Never rotate it casually: every enrolled secret needs the key it was sealed with (see docs/ops/runbook.md).
TOTP_ENCRYPTION_KEY=
