# Copy to .env.local for `npm run dev` / `npm run worker` against a local Postgres.
APP_ENV=development
DATABASE_URL=postgres://makam:makam@127.0.0.1:5432/makam

# Sentry: leave empty to disable.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# Browser events take their environment from the page host (stg.makam.co.id = staging).
NEXT_PUBLIC_SENTRY_DSN=

# Optional, development and test only: Svix secret (whsec_...) the fake PaymentProvider signs webhooks with.
FAKE_PAYMENT_WEBHOOK_SECRET=

# Login sessions (Better Auth). Required in staging and production; development and test fall back to local values.
# AUTH_SECRET: at least 32 random characters, e.g. `openssl rand -base64 48`.
AUTH_SECRET=
# The site's own origin; https makes the session cookie Secure.
APP_BASE_URL=

# EmailSender: the SumoPod SMTP relay (implicit TLS on 465, certificate verified). Required in staging and
# production (SMTP_USER, SMTP_PASSWORD, EMAIL_FROM); development and test use the fake EmailSender and ignore these.
# The real values live only on the VPS (e.g. /opt/makam-v1/staging/staging.env), never in the repo or a ticket.
SMTP_HOST=smtp.sumopod.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@makam.co.id
EMAIL_FROM_NAME=Makam.co.id

# PaymentProvider: SumoPod's Managed Payment API (QRIS up to Rp 10 juta, Virtual Account above it up to
# SUMOPOD_BATAS_VA, manual transfer beyond that; ADR 0013). Required in staging and
# production (SUMOPOD_API_KEY, SUMOPOD_WEBHOOK_SECRET); development and test use the fake PaymentProvider and
# ignore these. The real values live only on the VPS (e.g. /opt/makam-v1/staging/staging.env), never in the repo
# or a ticket. Left unset, SUMOPOD_BASE_URL defaults to the sandbox host in staging and the live host in
# production (ticket 07 installs live keys on the switch day; it need not set this at all).
SUMOPOD_API_KEY=
SUMOPOD_WEBHOOK_SECRET=
SUMOPOD_BASE_URL=
# Largest Tagihan paid by Virtual Account (whole rupiah). Unset or 0 = Virtual Account off: everything above the
# QRIS cap is paid by transfer to the Operator's account (Pengaturan Operator) and recorded by Admin Platform.
SUMOPOD_BATAS_VA=

# Web push to staff (VAPID, RFC 8292). Required in staging and production; development and test use a fixed local pair.
# Generate the pair once per environment with `npx web-push generate-vapid-keys` (unpadded base64url). Rotating it
# invalidates every stored push subscription: staff enable push again on each device.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# The contact push services see: mailto:<email> or an https URL (never localhost).
VAPID_SUBJECT=
# Development only, opt-in: keep files (e.g. seeded Lokasi photos) on this local directory so the dev web server serves them.
DEV_FILES_ROOT=
