# Copy to .env.local for `npm run dev` / `npm run worker` against a local Postgres.
APP_ENV=development
DATABASE_URL=postgres://makam:makam@127.0.0.1:5432/makam

# Sentry: leave empty to disable.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# Optional, development and test only: Svix secret (whsec_...) the fake PaymentProvider signs webhooks with.
FAKE_PAYMENT_WEBHOOK_SECRET=

# Login sessions (Better Auth). Required in staging and production; development and test fall back to local values.
# AUTH_SECRET: at least 32 random characters, e.g. `openssl rand -base64 48`.
AUTH_SECRET=
# The site's own origin; https makes the session cookie Secure.
APP_BASE_URL=
