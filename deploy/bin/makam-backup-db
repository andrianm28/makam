#!/usr/bin/env bash
# makam-backup-db: nightly encrypted pg_dump of one environment's Postgres,
# kept 7 days on the host (ADR 0002, beta UAT amendment), run by
# makam-<env>-db-backup.timer. Coordinates with makam-backup-files (the
# FileStore tar, ticket 60) and with ticket 72's pre-migrate dump: same host,
# same 7-day window, separate files, so losing one backup never loses another.
#
#   makam-backup-db --env staging|prod
#   makam-backup-db --env staging --container <name>   # a Postgres other than
#                                                       # the compose default
#
# The Dump is client-side encrypted with the passphrase in
# $MAKAM_ROOT/<env>/backup-passphrase (0600, never in the repo), and each night
# writes two files that share a timestamp:
#
#   $MAKAM_ROOT/<env>/backups/db/makam-<UTC timestamp>.dump.enc    pg_dump -Fc
#   $MAKAM_ROOT/<env>/backups/db/makam-<UTC timestamp>.counts.enc  table=count
#
# The counts are what makam-restore-test checks a restore against, so a restore
# can be proved lossless without the source database. The Dump goes through a
# pipe (pg_dump on the container's local socket, no password anywhere), is
# written under a temporary name and only renamed once it is complete, and
# fails closed: with less than twice the free space it needs, with no
# passphrase, or with a size it could not read, it writes nothing at all.
set -euo pipefail

MAKAM_ROOT=${MAKAM_ROOT:-/opt/makam-v1}
RETENTION_DAYS=7
LOG_TAG=makam-db-backup
ENV_NAME=""

# shellcheck source=deploy/bin/makam-backup-lib
. "$(dirname "$(readlink -f "$0")")/makam-backup-lib"

usage() { sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

SOURCE_CONTAINER=""
while [ $# -gt 0 ]; do
  case "$1" in
    --env) ENV_NAME=${2:?}; shift 2 ;;
    --container) SOURCE_CONTAINER=${2:?}; shift 2 ;;
    -h|--help) usage 0 ;;
    *) echo "unknown argument: $1" >&2; usage 64 ;;
  esac
done
case "$ENV_NAME" in
  staging|prod) ;;
  *) echo "--env must be staging or prod" >&2; exit 64 ;;
esac
[ -n "$SOURCE_CONTAINER" ] || SOURCE_CONTAINER="makam-$ENV_NAME-postgres-1"

DEST="$MAKAM_ROOT/$ENV_NAME/backups/db"
PASSPHRASE_FILE=${MAKAM_BACKUP_PASSPHRASE_FILE:-$MAKAM_ROOT/$ENV_NAME/backup-passphrase}
STAMP=$(date -u +%Y%m%dT%H%M%SZ)
DUMP="makam-$STAMP.dump.enc"
COUNTS="makam-$STAMP.counts.enc"

# The passphrase comes from a file, never from a command line, and never from
# the environment the operator sets: 0600 on the host, read once here. One line:
# `openssl enc` uses the first line of its password, so a longer passphrase would
# silently be a shorter one.
[ -r "$PASSPHRASE_FILE" ] || refuse "missing $PASSPHRASE_FILE (create it with: umask 077; openssl rand -base64 32 > $PASSPHRASE_FILE)"
PASSPHRASE=$(cat "$PASSPHRASE_FILE")
[ -n "$PASSPHRASE" ] || refuse "$PASSPHRASE_FILE is empty"
case "$PASSPHRASE" in
  *"
"*) refuse "$PASSPHRASE_FILE has more than one line; openssl would use only the first" ;;
esac

if [ "$(docker inspect -f '{{.State.Running}}' "$SOURCE_CONTAINER" 2> /dev/null || true)" != true ]; then
  err "ERROR container $SOURCE_CONTAINER is not running; no Dump taken"
  exit 1
fi

# The size of the database being dumped, for the free-space rule below. A size
# that does not answer must not read as zero free space needed.
DB_SIZE=$(docker exec "$SOURCE_CONTAINER" psql -U "$DB_USER" -d "$DB_NAME" -Atc "select pg_database_size('$DB_NAME')" 2> /dev/null | tr -d '[:space:]')
case "$DB_SIZE" in
  '' | *[!0-9]* | 0) refuse "could not read the size of $DB_NAME in $SOURCE_CONTAINER; no Dump taken" ;;
esac
require_free_space "$MAKAM_ROOT" $((DB_SIZE * 2)) "$DB_NAME"

install -d -m 0700 "$DEST"
export BACKUP_PASSPHRASE="$PASSPHRASE"

# The dump and the row counts, both written under a temporary name and renamed
# only when complete, so an interrupted run can never leave a half Dump that
# looks like a good night.
PART="$DEST/.makam-$STAMP.dump.enc.part"
if ! docker exec "$SOURCE_CONTAINER" pg_dump -U "$DB_USER" -d "$DB_NAME" -Fc --no-owner --no-privileges \
  | openssl enc "${CIPHER_ARGS[@]}" -salt -in /dev/stdin -out "$PART" -pass env:BACKUP_PASSPHRASE; then
  err "ERROR pg_dump of $SOURCE_CONTAINER or its encryption failed; nothing was written"
  rm -f "$PART"
  exit 1
fi

# Every table in the public schema as `table=count` lines, which the restore
# check reads back to prove a restore lost nothing.
if ! docker exec "$SOURCE_CONTAINER" psql -U "$DB_USER" -d "$DB_NAME" -Atc "$COUNTS_QUERY" \
  | openssl enc "${CIPHER_ARGS[@]}" -salt -in /dev/stdin -out "$DEST/.makam-$STAMP.counts.enc.part" -pass env:BACKUP_PASSPHRASE; then
  err "ERROR the row counts of $SOURCE_CONTAINER or their encryption failed; no Dump kept"
  rm -f "$DEST/.makam-$STAMP.counts.enc.part"
  exit 1
fi

mv "$PART" "$DEST/$DUMP"
mv "$DEST/.makam-$STAMP.counts.enc.part" "$DEST/$COUNTS"

# Only this script's own files, older than the window: the FileStore tar, the
# pre-migrate dump (ticket 72) and anything an operator put there stay.
find "$DEST" -maxdepth 1 -name 'makam-*.dump.enc' -mtime "+$RETENTION_DAYS" -delete
find "$DEST" -maxdepth 1 -name 'makam-*.counts.enc' -mtime "+$RETENTION_DAYS" -delete

log "dumped $SOURCE_CONTAINER ($DB_NAME, $(mib "$DB_SIZE") MiB) to $DEST/$DUMP, pruned dumps older than ${RETENTION_DAYS}d"
heartbeat "$ENV_NAME" dumped
