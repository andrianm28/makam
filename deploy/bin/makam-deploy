#!/usr/bin/env bash
# makam-deploy: pull-based deploy of a v1 compose project on this host.
#
# Run every 2 minutes by makam-<env>-deploy.timer (as ubuntu, which holds the
# ghcr read:packages login), or by hand for a rollback. No inbound SSH key and
# no GitHub secret: the host polls ghcr for the image CI pushed from `main`.
#
#   makam-deploy --env staging                     follow ghcr :latest and deploy that digest
#   makam-deploy --env staging --tag sha-<git>     deploy / roll back to an exact tag
#   makam-deploy --env staging --digest sha256:... deploy an exact digest (a promotion)
#   makam-deploy --env staging --tag X --local     a local image, no pull and no signature (tests)
#   makam-deploy --env staging --force             redeploy even if already current
#
# Order, and what a failure leaves running:
#   1. pull the image           fails -> nothing touched (3 tries, 10 s and 30 s apart)
#   2. verify the signature     unsigned or wrongly signed -> nothing touched
#   3. pg_dump (prod only)      fails -> nothing touched
#   4. run --rm migrate         fails -> nothing restarted; old web/worker keep running
#   5. up -d --wait             fails -> automatic roll back to the previous digest
#                               (its pull of that digest is tried 3 times as well)
#   6. /api/health must be 200  fails -> automatic roll back to the previous digest
#   7. create the GlitchTip release for the commit (best effort, never fatal)
#   8. makam-prune-images, so the host keeps at most MAKAM_KEEP_IMAGES (3)
#      versions of this image per environment (never fatal either)
#
# A mutable tag is only a pointer: whatever it names is resolved to a digest, the
# digest's cosign signature is checked against this environment's public key, and
# the digest is what runs. Staging and production have separate keys, so neither
# host accepts the other's images. The database is never rolled back: migrations
# are forward-only, so rolling the image back only works while the previous
# image still tolerates the new schema.
#
# Exit codes:
#   0   deployed and healthy, or already on that digest
#   1   pull, snapshot, migrate or up failed, or the health check never came
#       back and the roll back to the previous digest worked
#   2   the roll back to the previous digest failed as well: the new, unhealthy
#       image is what is still running, which is the one state needing a human
#   64  usage
#   77  the image is unsigned or signed with another key (nothing was touched)
#   78  the host or the env file is not set up for a deploy
#
# Refuses to run (exit 78) unless <env>.env names MAKAM_PROJECT=makam-<env> and
# the matching MAKAM_APP_ENV (staging / production), and refuses any image other
# than ghcr.io/andrianm28/makam. Pruning only ever untags that repository's
# sha-<40 hex> tags.
#
# Files under $MAKAM_ROOT/<env>/ (see docs/ops/runbook.md):
#   compose.yml     copy of docker-compose.prod.yml (installed by deploy/install-host.sh)
#   <env>.env       secrets + settings, mode 0600, never in the repo
#   cosign.pub      this environment's cosign public key (installed by deploy/install-host.sh)
#   deployed.env    MAKAM_TAG / MAKAM_DIGEST / MAKAM_DEPLOY_REF / MAKAM_RELEASE of the running release
#   deploy.log      one line per step
#   backups/db/     pg_dump snapshots, production only
set -euo pipefail

MAKAM_ROOT=${MAKAM_ROOT:-/opt/makam-v1}
ENV_NAME=""
TAG=""
DIGEST=""
LOCAL=0
FORCE=0
VERIFY_IMAGE="$MAKAM_ROOT/bin/makam-verify-image"
STATUS_SCRIPT="$MAKAM_ROOT/bin/makam-deploy-status"
RELEASE_SCRIPT="$MAKAM_ROOT/bin/makam-glitchtip-release"
PRUNE_SCRIPT="$MAKAM_ROOT/bin/makam-prune-images"
# How long /api/health has to answer 200 after `up`, in seconds. 180 on a host:
# the worker's first heartbeat on an empty database takes about 90 s.
HEALTH_WAIT=${MAKAM_HEALTH_WAIT:-180}
HEALTH_INTERVAL=${MAKAM_HEALTH_INTERVAL:-5}

usage() { sed -n '2,/^set -euo/p' "$0" | sed -n 's/^# \{0,1\}//p' | sed '$d'; exit "${1:-0}"; }

while [ $# -gt 0 ]; do
  case "$1" in
    --env) ENV_NAME=${2:?}; shift 2 ;;
    --tag) TAG=${2:?}; shift 2 ;;
    --digest) DIGEST=${2:?}; shift 2 ;;
    --local) LOCAL=1; shift ;;
    --force) FORCE=1; shift ;;
    -h|--help) usage 0 ;;
    *) echo "unknown argument: $1" >&2; usage 64 ;;
  esac
done
case "$ENV_NAME" in
  staging) APP_ENV_EXPECTED=staging ;;
  prod) APP_ENV_EXPECTED=production ;;
  *) echo "--env must be staging or prod" >&2; exit 64 ;;
esac
[ -n "$TAG" ] && [ -n "$DIGEST" ] && { echo "use --tag or --digest, not both" >&2; exit 64; }
true

# The only image this script deploys or prunes.
ALLOWED_IMAGE=ghcr.io/andrianm28/makam

DIR="$MAKAM_ROOT/$ENV_NAME"
PROJECT="makam-$ENV_NAME"
ENV_FILE="$DIR/$ENV_NAME.env"
DEPLOYED_FILE="$DIR/deployed.env"
LOG="$DIR/deploy.log"
[ -r "$ENV_FILE" ] || { echo "missing $ENV_FILE" >&2; exit 78; }
[ -r "$DIR/compose.yml" ] || { echo "missing $DIR/compose.yml" >&2; exit 78; }

setting() { sed -n "s/^$1=//p" "$ENV_FILE" | tail -n 1; }
refuse() { echo "refusing to deploy: $*" >&2; exit 78; }

# A variable in this process's environment would override the env file in
# compose's interpolation, so both must agree with the allow-list.
IMAGE=$(setting MAKAM_IMAGE); IMAGE=${IMAGE:-$ALLOWED_IMAGE}
[ "$IMAGE" = "$ALLOWED_IMAGE" ] || refuse "MAKAM_IMAGE=$IMAGE in $ENV_FILE; only $ALLOWED_IMAGE is allowed"
[ "${MAKAM_IMAGE:-$ALLOWED_IMAGE}" = "$ALLOWED_IMAGE" ] || refuse "MAKAM_IMAGE=$MAKAM_IMAGE in the environment; only $ALLOWED_IMAGE is allowed"
[ "$(setting MAKAM_PROJECT)" = "$PROJECT" ] || refuse "$ENV_FILE must set MAKAM_PROJECT=$PROJECT"
[ "${MAKAM_PROJECT:-$PROJECT}" = "$PROJECT" ] || refuse "MAKAM_PROJECT=$MAKAM_PROJECT in the environment; expected $PROJECT"
[ "$(setting MAKAM_APP_ENV)" = "$APP_ENV_EXPECTED" ] || refuse "$ENV_FILE must set MAKAM_APP_ENV=$APP_ENV_EXPECTED"
[ "${MAKAM_APP_ENV:-$APP_ENV_EXPECTED}" = "$APP_ENV_EXPECTED" ] || refuse "MAKAM_APP_ENV=$MAKAM_APP_ENV in the environment; expected $APP_ENV_EXPECTED"
export MAKAM_IMAGE="$IMAGE" MAKAM_PROJECT="$PROJECT" MAKAM_APP_ENV="$APP_ENV_EXPECTED"
WEB_PORT=$(setting MAKAM_WEB_PORT)
: "${WEB_PORT:?MAKAM_WEB_PORT missing from $ENV_FILE}"

log() {
  local line
  line="$(date -Is) [$PROJECT] $*"
  echo "$line"
  echo "$line" >> "$LOG"
}

# One deploy at a time; a timer tick during a deploy just exits.
exec 9> "$DIR/.deploy.lock"
if ! flock -n 9; then
  echo "another deploy of $PROJECT is running; skipping"
  exit 0
fi

touch "$DEPLOYED_FILE"
compose() {
  docker compose -p "$PROJECT" -f "$DIR/compose.yml" --env-file "$ENV_FILE" --env-file "$DEPLOYED_FILE" "$@"
}
current_tag() { sed -n 's/^MAKAM_TAG=//p' "$DEPLOYED_FILE" | tail -n 1; }
current_digest() { sed -n 's/^MAKAM_DIGEST=//p' "$DEPLOYED_FILE" | tail -n 1; }
revision_of() { docker image inspect --format '{{ index .Config.Labels "org.opencontainers.image.revision" }}' "$1" 2>/dev/null || true; }
digest_of() { docker image inspect --format '{{range .RepoDigests}}{{println .}}{{end}}' "$1" 2>/dev/null | head -n 1 | sed -n 's/.*@//p'; }
record_release() {
  printf 'MAKAM_TAG=%s\nMAKAM_DIGEST=%s\nMAKAM_DEPLOY_REF=:%s@%s\nMAKAM_RELEASE=%s\nPREVIOUS_TAG=%s\nDEPLOYED_AT=%s\n' \
    "$1" "$2" "$1" "$2" "${REV:-$1}" "$PREVIOUS" "$(date -Is)" > "$DEPLOYED_FILE"
}
# ghcr answers a TLS handshake timeout now and then (six times on 2026-10-03), and
# a timer that gave up on the first one lost a whole cycle. So a pull is tried up
# to three times, 10 s and then 30 s apart, before it counts as failed
# (makam-preflight keeps the same rule for its own pull). Each retry is a WARNING
# line in deploy.log; docker's own error text stays on stderr.
PULL_BACKOFFS=(10 30)
pull_with_retries() {
  local ref=$1 attempt=1 tries=$((${#PULL_BACKOFFS[@]} + 1)) delay
  until docker pull -q "$ref" > /dev/null; do
    [ "$attempt" -lt "$tries" ] || return 1
    delay=${PULL_BACKOFFS[$((attempt - 1))]}
    log "WARNING pull $ref failed (try $attempt of $tries); trying again in ${delay}s"
    sleep "$delay"
    attempt=$((attempt + 1))
  done
}
pull() { pull_with_retries "$1" || { log "ERROR pull $1 failed; nothing changed"; exit 1; }; }

running() { [ -n "$(compose ps --status running -q "$1" 2>/dev/null)" ]; }

# GitHub Deployment + status, so the deploy is visible in the repository. Best
# effort: a missing token or a GitHub outage must never fail a deploy.
status() {
  [ -x "$STATUS_SCRIPT" ] || return 0
  "$STATUS_SCRIPT" --env "$ENV_NAME" "$@" >> "$LOG" 2>&1 || true
}

# 7. The GlitchTip release for the commit that is now running, so its first
# error event has a release (and the source maps ci.yml uploaded for that commit)
# to point at. Best effort like `status`: reporting never fails a deploy.
release() {
  [ -x "$RELEASE_SCRIPT" ] || return 0
  [ -n "${REV:-}" ] || return 0
  "$RELEASE_SCRIPT" --env "$ENV_NAME" --release "$REV" >> "$LOG" 2>&1 || true
}

# Put the previous digest back after a failed `up` or health check. The
# migrations stay: they are forward-only, so this only works while the previous
# image tolerates the new schema (runbook, "Forward-only migrations").
roll_back() {
  if [ -z "${PREVIOUS_DIGEST:-}" ]; then
    log "ERROR no previous digest recorded, nothing to roll back to; $TAG is running and unhealthy"
    return 1
  fi
  export MAKAM_TAG="$PREVIOUS" MAKAM_DIGEST="$PREVIOUS_DIGEST" \
    MAKAM_DEPLOY_REF=":$PREVIOUS@$PREVIOUS_DIGEST" MAKAM_RELEASE="$PREVIOUS"
  if ! pull_with_retries "$IMAGE@$PREVIOUS_DIGEST" 2> /dev/null \
    || ! compose up -d --wait --wait-timeout 180 >> "$LOG" 2>&1; then
    log "ERROR roll back to $PREVIOUS_DIGEST failed; $TAG ($DIGEST) is still running"
    return 1
  fi
  # deployed.env must keep describing what is running, not what was tried.
  printf '%s' "$PREVIOUS_RECORD" > "$DEPLOYED_FILE"
  log "rolled back to $PREVIOUS ($PREVIOUS_DIGEST)"
}

# 8. Bound the makam images on this host. Its own script, so the runbook can
#    run it by hand and so its rules are tested on their own; it untags only
#    ghcr.io/andrianm28/makam sha-<commit> versions outside the retention set
#    and never fails a deploy that is already healthy.
prune() {
  if [ ! -x "$PRUNE_SCRIPT" ]; then
    log "NOTE $PRUNE_SCRIPT is not installed, so the makam images on this host are not being bounded (run deploy/install-host.sh)"
    return 0
  fi
  local status=0
  "$PRUNE_SCRIPT" --env "$ENV_NAME" >> "$LOG" 2>&1 || status=$?
  [ "$status" -eq 0 ] || log "WARNING image retention exited $status; see the lines above in deploy.log"
}

# Production only: a snapshot before the migration, so a bad migration has
# something to compare against. Never restored automatically (runbook,
# "Production (ticket 65)").
snapshot() {
  local dir="$DIR/backups/db" file
  mkdir -p "$dir"
  chmod 0700 "$dir"
  file="$dir/makam-$(date -u +%Y%m%dT%H%M%SZ).dump"
  if ! compose exec -T postgres pg_dump -U makam -d makam -Fc > "$file" 2>> "$LOG"; then
    log "ERROR pg_dump failed; refusing to migrate production"
    rm -f "$file"
    exit 1
  fi
  chmod 0600 "$file"
  find "$dir" -name 'makam-*.dump' -type f | sort | head -n -7 | xargs -r rm -f
  log "snapshot $file"
}

# 1. Resolve the target to a digest. A tag is only ever a pointer to one.
if [ -n "$DIGEST" ]; then
  pull "$IMAGE@$DIGEST"
  REV=$(revision_of "$IMAGE@$DIGEST")
  TAG="sha-${REV:-unknown}"
elif [ -n "$TAG" ]; then
  if [ "$LOCAL" = 1 ]; then
    docker image inspect "$IMAGE:$TAG" > /dev/null 2>&1 || { log "ERROR local image $IMAGE:$TAG not found"; exit 1; }
  else
    pull "$IMAGE:$TAG"
  fi
  DIGEST=$(digest_of "$IMAGE:$TAG")
  [ -n "$DIGEST" ] || { log "ERROR $IMAGE:$TAG has no digest; refusing to deploy a tag with no digest"; exit 1; }
  REV=$(revision_of "$IMAGE:$TAG")
else
  # The timer: ghcr :latest moves only after a `main` run passed every gate and
  # CI signed the image, so following it means following the newest signed digest.
  pull "$IMAGE:latest"
  DIGEST=$(digest_of "$IMAGE:latest")
  [ -n "$DIGEST" ] || { log "ERROR $IMAGE:latest has no digest; nothing changed"; exit 1; }
  REV=$(revision_of "$IMAGE:latest")
  TAG="sha-${REV:-unknown}"
fi

PREVIOUS=$(current_tag)
PREVIOUS_DIGEST=$(current_digest)
# What deployed.env said before this run, so a roll back can put it back.
PREVIOUS_RECORD=$(cat "$DEPLOYED_FILE")

# 2. The signature. An unsigned or wrongly signed image never reaches `migrate`
#    and is never pulled into a running state.
if [ "$LOCAL" = 1 ]; then
  [ "$ENV_NAME" = prod ] && refuse "--local is not allowed for production"
  log "WARNING signature NOT verified (--local, tests only)"
else
  verify_status=0
  "$VERIFY_IMAGE" --env "$ENV_NAME" --image "$IMAGE" --digest "$DIGEST" >> "$LOG" 2>&1 || verify_status=$?
  if [ "$verify_status" -ne 0 ]; then
    log "ERROR refusing $IMAGE@$DIGEST: signature check exited $verify_status; nothing changed"
    # No Deployment yet (begin comes after this check), so this refusal is log-only.
    exit 77
  fi
  log "signature ok for $DIGEST"
fi

if [ "$FORCE" = 0 ] && [ "$DIGEST" = "$PREVIOUS_DIGEST" ] && running web && running worker; then
  echo "$PROJECT already on $TAG ($DIGEST)"
  exit 0
fi

log "deploy $IMAGE@$DIGEST ($TAG, revision ${REV:-unknown}); running: ${PREVIOUS:-(none)} ${PREVIOUS_DIGEST:-(none)}"
status begin --digest "$DIGEST" --tag "$TAG" --description "Deploy $TAG to $PROJECT"
status state --state in_progress --description "migrate and restart $PROJECT on $TAG"
export MAKAM_TAG="$TAG" MAKAM_DIGEST="$DIGEST" MAKAM_DEPLOY_REF=":$TAG@$DIGEST" MAKAM_RELEASE="${REV:-$TAG}"

# 3. A production snapshot, before the migration.
[ "$ENV_NAME" = prod ] && snapshot

# 4. Migrate with the new image. web/worker are not touched unless this succeeds.
if ! compose run --rm --quiet-pull migrate >> "$LOG" 2>&1; then
  log "ERROR migrate failed for $TAG; web/worker left running ${PREVIOUS:-(none)}; nothing restarted"
  status state --state failure --description "migrate failed on $TAG; ${PREVIOUS:-(nothing)} still running"
  exit 1
fi
log "migrate ok"

# 5. Restart web and worker on the verified digest.
if ! compose up -d --wait --wait-timeout 180 >> "$LOG" 2>&1; then
  log "ERROR up failed for $TAG; rolling back to ${PREVIOUS:-(none)}"
  status state --state failure --description "up failed on $TAG; rolling back to ${PREVIOUS:-(none)}"
  roll_back || exit 2
  exit 1
fi
record_release "$TAG" "$DIGEST"
log "web and worker up on $TAG ($DIGEST)"

# 6. Health: DB reachable and a fresh worker heartbeat.
deadline=$(( $(date +%s) + HEALTH_WAIT ))
while [ "$(date +%s)" -lt "$deadline" ]; do
  if curl -fs -m 5 -o /dev/null "http://127.0.0.1:$WEB_PORT/api/health"; then
    log "healthy on $TAG ($DIGEST)"
    status state --state success --description "$TAG ($DIGEST) healthy"
    release
    prune
    exit 0
  fi
  sleep "$HEALTH_INTERVAL"
done
log "ERROR $TAG deployed but /api/health is not 200 after ${HEALTH_WAIT}s; rolling back to ${PREVIOUS:-(none)}"
status state --state failure --description "$TAG ($DIGEST) never became healthy; rolling back to ${PREVIOUS:-(none)}"
# Exit 1: the deploy failed and the previous digest is running again. Exit 2 is
# reserved for a roll back that failed as well, so a timer or a monitor can tell
# "recovered on its own" from "something is still broken".
roll_back || exit 2
exit 1
