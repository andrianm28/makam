#!/usr/bin/env bash
# makam-preflight: which prerequisite of the production go-live is still missing?
#
#   makam-preflight --env prod [--digest sha256:...] [--email-to <address>]
#                   [--skip-s3] [--webhook-url <url>]
#
# Run by the owner on the VPS before the production rehearsal (ticket 72,
# "Added 2026-10-03"; docs/ops/runbook.md, "Production preflight"). One line per
# check:
#
#   PASS [02] docker: ...        the prerequisite holds
#   FAIL [03] s3 probe: ...      it does not; the reason says what to do
#   SKIP [72] uptime monitor: .. cannot be checked from here; the instruction is on the line
#
# The bracket names the ticket items a check proves (02 infrastructure, 03 S3,
# 04 SumoPod, 72 deploys). Exit 0 when nothing FAILed, 1 otherwise, 64 on usage.
#
# Read-only, except for objects it names itself and removes again: the S3 probe
# object and the GitHub probe Deployment. It never prints a secret value: env
# file settings are read with sed (the file is never sourced), handed to the one
# command that needs them, and only names or reasons are written out. The
# existing scripts and CLIs do the work (makam-diskcheck, makam-verify-image,
# makam-backup-db, makam-restore-test, email-check, env-check); this script
# only calls them and reads their exit codes.
set -euo pipefail

MAKAM_ROOT=${MAKAM_ROOT:-/opt/makam-v1}
ENV_NAME=""
DIGEST=""
EMAIL_TO=""
SKIP_S3=0
WEBHOOK_URL=""

usage() { sed -n '2,/^set -euo/p' "$0" | sed -n 's/^# \{0,1\}//p' | sed '$d'; exit "${1:-0}"; }

while [ $# -gt 0 ]; do
  case "$1" in
    --env) ENV_NAME=${2:?}; shift 2 ;;
    --digest) DIGEST=${2:?}; shift 2 ;;
    --email-to) EMAIL_TO=${2:?}; shift 2 ;;
    --skip-s3) SKIP_S3=1; shift ;;
    --webhook-url) WEBHOOK_URL=${2:?}; shift 2 ;;
    -h|--help) usage 0 ;;
    *) echo "unknown argument: $1" >&2; usage 64 ;;
  esac
done
[ "$ENV_NAME" = prod ] || { echo "--env must be prod" >&2; usage 64; }

DIR="$MAKAM_ROOT/$ENV_NAME"
ENV_FILE="$DIR/$ENV_NAME.env"
FAILS=0
IMAGE=ghcr.io/andrianm28/makam
IMAGE_REF=""
PULLED=0

# One setting of the env file; the file is never sourced and the value never printed.
setting() { sed -n "s/^$1=//p" "$ENV_FILE" 2> /dev/null | tail -n 1 || true; }

line() { printf '%s [%s] %s: %s\n' "$1" "$2" "$3" "$4"; }
pass() { line PASS "$@"; }
skip() { line SKIP "$@"; }
fail() { FAILS=$((FAILS + 1)); line FAIL "$@"; }

check_env_file() {
  if [ ! -r "$ENV_FILE" ]; then
    fail "02, 72" "env file" "$ENV_FILE is missing or unreadable; create it as in docs/ops/runbook.md, \"Production (ticket 65)\""
    return 1
  fi
  local mode
  mode=$(stat -c %a "$ENV_FILE")
  if [ "$mode" != 600 ]; then
    fail "02, 72" "env file" "$ENV_FILE has mode 0$mode; it holds every secret, so chmod 600 it"
    return 1
  fi
  pass "02, 72" "env file" "$ENV_FILE exists, mode 0600"
}

check_docker() {
  if docker info > /dev/null 2>&1; then
    pass "02" "docker daemon" "answers"
  else
    fail "02" "docker daemon" "docker info fails; start Docker (systemctl start docker) and check this user is in the docker group"
  fi
  if docker compose version > /dev/null 2>&1; then
    pass "02" "compose plugin" "docker compose is installed"
  else
    fail "02" "compose plugin" "docker compose version fails; install the docker-compose-plugin package"
  fi
}

# Free disk is makam-diskcheck's own verdict (85 % by default); memory is what
# `free` calls available, against MAKAM_PREFLIGHT_MIN_MEM_MB (1024 by default).
check_resources() {
  local bin disk_out mem
  bin="$MAKAM_ROOT/bin"
  if disk_out=$("$bin/makam-diskcheck" / 2>&1); then
    pass "02" "disk" "makam-diskcheck: the root filesystem is below its warning"
  else
    fail "02" "disk" "makam-diskcheck warns (${disk_out:-no output}); free space as in the runbook, \"What to do when it warns\" (threshold ${MAKAM_DISK_WARN_PERCENT:-85}%)"
  fi
  mem=$(free -m 2>/dev/null | awk '/^Mem:/ { print $7 }')
  case "$mem" in
    ''|*[!0-9]*) fail "02" "memory" "free -m gave no available figure"; return 0 ;;
  esac
  if [ "$mem" -ge "${MAKAM_PREFLIGHT_MIN_MEM_MB:-1024}" ]; then
    pass "02" "memory" "${mem} MB available (minimum ${MAKAM_PREFLIGHT_MIN_MEM_MB:-1024})"
  else
    fail "02" "memory" "only ${mem} MB available, minimum ${MAKAM_PREFLIGHT_MIN_MEM_MB:-1024}: web, worker, Postgres and GlitchTip will not fit beside the other projects"
  fi
}

# DNS must already point at this host (the switch is only nginx, ticket 02), and
# each name's certificate must have MAKAM_PREFLIGHT_CERT_DAYS (14) left.
check_dns_and_certificates() {
  local expected host got end days
  expected=${MAKAM_PREFLIGHT_EXPECTED_IP:-103.92.214.243}
  days=${MAKAM_PREFLIGHT_CERT_DAYS:-14}
  for host in makam.co.id www.makam.co.id; do
    got=$(getent ahostsv4 "$host" 2>/dev/null | awk 'NR == 1 { print $1 }')
    if [ "$got" = "$expected" ]; then
      pass "02" "dns $host" "$got"
    else
      fail "02" "dns $host" "resolves to ${got:-nothing}, expected $expected (this host)"
    fi
    end=$(openssl s_client -connect "$host:443" -servername "$host" < /dev/null 2> /dev/null | openssl x509 -noout -enddate 2> /dev/null | sed -n 's/^notAfter=//p') || true
    if openssl s_client -connect "$host:443" -servername "$host" < /dev/null 2> /dev/null | openssl x509 -noout -checkend $((days * 86400)) > /dev/null 2>&1; then
      pass "02" "certificate $host" "valid until $end (more than $days days)"
    else
      fail "02" "certificate $host" "expires ${end:-unknown} or cannot be read (less than $days days left); run certbot renew"
    fi
  done
}

# The digest to prove is --digest, else the one deployed.env records. The pull
# uses the ghcr read token when the env file holds GHCR_READ_TOKEN (in a
# throwaway Docker config that is removed again), else the host's own login.
check_image_pull() {
  local digest login_note config token
  digest=$DIGEST
  [ -n "$digest" ] || digest=$(sed -n 's/^MAKAM_DIGEST=//p' "$DIR/deployed.env" 2> /dev/null | tail -n 1) || digest=""
  if [ -z "$digest" ]; then
    fail "72" "ghcr pull" "no released digest known: pass --digest sha256:<digest of a released image> (the digest the promotion printed)"
    return 0
  fi
  IMAGE_REF="$IMAGE@$digest"
  DIGEST=$digest
  config=""
  login_note="the host's own ghcr login"
  token=$(setting GHCR_READ_TOKEN)
  if [ -n "$token" ]; then
    config=$(mktemp -d)
    login_note="the read token from $ENV_NAME.env"
    if ! printf '%s' "$token" | DOCKER_CONFIG="$config" docker login ghcr.io -u andrianm28 --password-stdin > /dev/null 2>&1; then
      rm -rf "$config"
      fail "02, 72" "ghcr pull" "docker login ghcr.io refused GHCR_READ_TOKEN: create a token with read:packages (ticket 02)"
      return 0
    fi
  fi
  if DOCKER_CONFIG="${config:-${DOCKER_CONFIG:-$HOME/.docker}}" docker pull "$IMAGE_REF" > /dev/null 2>&1; then
    PULLED=1
    pass "02, 72" "ghcr pull" "pulled $IMAGE_REF with $login_note"
  else
    fail "02, 72" "ghcr pull" "could not pull $IMAGE_REF with $login_note: check the token's read:packages scope and that the digest exists"
  fi
  [ -z "$config" ] || rm -rf "$config"
}

# makam-verify-image decides; its exit code (77 unsigned / wrong key, 78 no key
# installed) is turned into words.
check_signature() {
  local code=0
  if [ "$PULLED" -ne 1 ]; then
    skip "72" "image signature" "needs the pulled image (ghcr pull above)"
    return 0
  fi
  "$MAKAM_ROOT/bin/makam-verify-image" --env "$ENV_NAME" --image "$IMAGE" --digest "$DIGEST" > /dev/null 2>&1 || code=$?
  case "$code" in
    0) pass "72" "image signature" "$DIGEST carries the production signature" ;;
    77) fail "72" "image signature" "no valid production signature: unsigned, or signed with another key than $DIR/cosign.pub (makam-verify-image exit 77); promote the release first" ;;
    78) fail "72" "image signature" "cosign is not installed or $DIR/cosign.pub is missing (exit 78): run deploy/install-host.sh and install the production public key" ;;
    *) fail "72" "image signature" "makam-verify-image exited $code" ;;
  esac
}

#@FUNCS

check_env_file || true
check_docker
check_resources
check_dns_and_certificates
check_image_pull
check_signature
#@CALLS

echo
if [ "$FAILS" -eq 0 ]; then
  echo "preflight: nothing FAILed (read the SKIP lines: they are yours to do)"
  exit 0
fi
echo "preflight: $FAILS check(s) FAILed"
exit 1
