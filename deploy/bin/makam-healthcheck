#!/usr/bin/env bash
# makam-healthcheck: local watchdog, run every minute by makam-<env>-health.timer.
#
#   makam-healthcheck https://dev.makam.co.id/api/health
#
# Goes through nginx and TLS like the external monitor does. A failure (no
# answer, non-200, or "ok" not true: DB down or stale worker heartbeat) is
# logged to the journal at priority err with tag makam-health, and the unit
# exits non-zero, so `systemctl --failed` and
# `journalctl -t makam-health -p err` show it. This is not an alarm: it cannot
# page anyone, and it dies with the host. The external monitor is the alarm
# (docs/ops/runbook.md, "Uptime alarm").
set -euo pipefail

URL=${1:?usage: makam-healthcheck <url>}

# curl and jq are expected to fail when staging is down; both are handled
# explicitly so `set -e` never ends the script before the failure is logged.
if ! body=$(curl -sS -m 10 -w '\n%{http_code}' "$URL" 2>&1); then
  code=000
else
  code=${body##*$'\n'}
fi
body=${body%$'\n'*}

if [ "$code" = 200 ] && printf '%s' "$body" | jq -e '.ok == true' > /dev/null 2>&1; then
  exit 0
fi
message="UNHEALTHY $URL http=$code body=$(printf '%s' "$body" | head -c 300 || true)"
logger -p user.err -t makam-health "$message"
echo "$message" >&2
exit 1
