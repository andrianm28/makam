# Weekly restore of the newest makam-prod Dump into a throwaway Postgres,
# checked against the row counts of the night it was taken
# (docs/ops/runbook.md, "Database backup and restore"). Installed by
# deploy/install-host.sh, which enables its timer only once production runs
# (ticket 108).
[Unit]
Description=Restore-check the newest makam-prod database backup
Wants=network-online.target
After=network-online.target docker.service makam-prod-db-backup.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
ExecStart=/opt/makam-v1/bin/makam-restore-test --env prod
TimeoutStartSec=20min

# Hardening, the same as staging's. Like the backup it needs the docker socket
# (it starts a throwaway Postgres with no network at all), and writes nothing
# itself: the Dump is read, the restored database lives in the container, which
# the script removes again.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/makam-v1
