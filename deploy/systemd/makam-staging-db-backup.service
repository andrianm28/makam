# Nightly encrypted pg_dump of the makam-staging database, kept 7 days
# (docs/ops/runbook.md, "Database backup and restore"). Installed by
# deploy/install-host.sh.
[Unit]
Description=Back up the makam-staging database (encrypted pg_dump, 7 days)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
ExecStart=/opt/makam-v1/bin/makam-backup-db --env staging
TimeoutStartSec=15min

# Hardening. It needs the docker socket (/run/docker.sock, a socket, so a
# read-only /run does not block it) to run pg_dump in the Postgres container,
# and write access to /opt/makam-v1 for the Dump and the passphrase beside it.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/makam-v1
