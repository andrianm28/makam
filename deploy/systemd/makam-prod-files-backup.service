# Nightly tar of the makam-prod FileStore volume, kept 7 days
# (docs/ops/runbook.md, "File storage and its backup"). Installed by
# deploy/install-host.sh, which enables its timer only once production runs
# (ticket 108): until /opt/makam-v1/prod/deployed.env has a MAKAM_DIGEST there
# is no makam-prod_files volume to read.
[Unit]
Description=Back up the makam-prod FileStore volume
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
ExecStart=/opt/makam-v1/bin/makam-backup-files --env prod
TimeoutStartSec=10min

# Hardening, the same as staging's. It still needs the docker socket
# (/run/docker.sock, a socket, so a read-only /run does not block it) and write
# access to /opt/makam-v1.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/makam-v1
