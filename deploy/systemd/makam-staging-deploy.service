# Pull-based deploy of makam-staging (docs/ops/runbook.md). Installed by deploy/install-host.sh.
[Unit]
Description=Deploy makam-staging from ghcr (migrate, then restart web/worker)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
ExecStart=/opt/makam-v1/bin/makam-deploy --env staging
TimeoutStartSec=15min

# Hardening. It still needs the docker socket (/run/docker.sock, a socket, so a
# read-only /run does not block it), ~/.docker/config.json for the ghcr login
# (read-only home is enough), cosign and curl in /usr/local/bin and /usr/bin for
# the signature check and the GitHub Deployment status, and write access to
# /opt/makam-v1.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/makam-v1
