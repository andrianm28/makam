# Nightly tar of the makam-staging FileStore volume, kept 7 days
# (docs/ops/runbook.md, "File storage and its backup"). Installed by
# deploy/install-host.sh.
[Unit]
Description=Back up the makam-staging FileStore volume
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
ExecStart=/opt/makam-v1/bin/makam-backup-files --env staging
TimeoutStartSec=10min

# Hardening. It still needs the docker socket (/run/docker.sock, a socket, so
# a read-only /run does not block it) and write access to /opt/makam-v1.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/makam-v1
