# The throwaway stack CI's e2e job starts on a GitHub-hosted runner (ticket 71):
# the pushed sha-<commit> image, run by the same docker-compose.prod.yml as
# staging and production, with its own empty Postgres. Development settings:
# APP_ENV=development wires the in-memory fakes (no message, payment or file
# leaves the runner) and serves /api/dev/*-outbox, which the e2e specs read.
# Nothing here is a secret; the values below are never used by a host.
#
# MAKAM_IMAGE and MAKAM_TAG come from the job (the exact image@digest pushed).
MAKAM_PROJECT=makam-e2e
MAKAM_APP_ENV=development
MAKAM_ENV_FILE=deploy/ci/e2e.env
MAKAM_WEB_PORT=3310
POSTGRES_PASSWORD=makam-e2e
DATABASE_URL=postgres://makam:makam-e2e@postgres:5432/makam
APP_BASE_URL=http://127.0.0.1:3310
SENTRY_ENVIRONMENT=ci-e2e
